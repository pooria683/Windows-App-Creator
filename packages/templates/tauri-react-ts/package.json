{
  "name": "{{APP_NAME}}",
  "version": "{{VERSION}}",
  "description": "{{DESCRIPTION}}",
  "author": "{{AUTHOR}}",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:windows": "tauri build --bundles nsis",
    "build:macos": "tauri build --bundles dmg",
    "build:linux": "tauri build --bundles appimage,deb,rpm",
    "build:web": "vite build",
    "package:exe": "tauri build --bundles nsis",
    "package:msi": "tauri build --bundles msi",
    "package:dmg": "tauri build --bundles dmg",
    "package:appimage": "tauri build --bundles appimage",
    "package:deb": "tauri build --bundles deb",
    "package:rpm": "tauri build --bundles rpm",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
