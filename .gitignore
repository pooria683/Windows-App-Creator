# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Lockfiles in generated examples (they are regenerated) ---
examples/*/package-lock.json

# --- Build output ---
dist/
build/
out/
release/
coverage/
*.tsbuildinfo
.turbo/
.vite/

# --- Runtime / generated by the CLI ---
# packages/cli/templates is produced from packages/templates at build time.
packages/cli/templates/

# --- Tauri / native ---
src-tauri/target/
src-tauri/WixTools/
src-tauri/gen/

# --- Env & local config (never commit secrets) ---
.env
.env.*
!.env.example
*.local

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editors & OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Certificates: never commit signing material ---
*.pfx
*.p12
*.cer
*.pem
*.key
