{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HelloTauri",
  "version": "0.1.0",
  "identifier": "com.winforge.examples.taurihello",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Hello Tauri",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Example Tauri app generated by WinForge.",
    "longDescription": "Example Tauri app generated by WinForge.",
    "publisher": "WinForge",
    "copyright": "Copyright \u00a9 2026 WinForge",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "upgradeCode": "FD8EF6FB-96D5-5BA9-B7FE-9D16E8AF41B4",
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "entitlements": null,
      "signingIdentity": null,
      "notarization": null
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {}
    }
  }
}
